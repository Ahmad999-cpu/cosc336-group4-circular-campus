# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Address printed inside asset QR labels. Use the address phones can reach, e.g. https://circular.example.edu
# (or http://<your-laptop-IP>:8000 for a demo on the same Wi-Fi). Empty = the address you opened the site with.
SITE_BASE_URL=

POSTGRES_DB=circular_campus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# fake = offline, deterministic. anthropic = real model (needs the key and requirements-ai.txt).
AI_PROVIDER=fake
# Matching (AI feature 2): lexical = offline, no download. sentence-transformers = better Arabic/English meaning.
EMBEDDING_BACKEND=lexical
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Public guest site (see docs/features/guest-site.md)
BRAND_NAME=Circular Campus
GUEST_CTA_URL=
# Home page film. Leave unset to use the built-in film (static/video/); set to a URL to host it elsewhere.
# GUEST_HOME_VIDEO=video/circular-campus-film.mp4
CONTACT_RECIPIENT=circularcampus.team@gmail.com
# Real e-mail for the contact form: uncomment and fill on the server only
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
